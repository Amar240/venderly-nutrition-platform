{
  "name": "woodbridge-nutrition",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001 -H 0.0.0.0",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "seed": "tsx prisma/seed.ts",
    "seed:woodbridge": "SEED_DISTRICT=woodbridge tsx prisma/seed.ts",
    "fixtures:generate": "tsx fixtures/generate.ts",
    "demo:reset": "npm run seed && npm run fixtures:generate",
    "logins": "tsx scripts/logins.ts",
    "deploy:image": "bash scripts/deploy-image.sh",
    "prisma:migrate": "prisma migrate dev",
    "prisma:generate": "prisma generate",
    "test": "vitest run",
    "test:tz": "TZ=Asia/Kolkata vitest run",
    "test:e2e": "playwright test --workers=1",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:tz && npm run build && git diff --check",
    "ci": "npm run check",
    "playwright:install": "playwright install chromium",
    "test:watch": "vitest"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.7.4",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-slot": "^1.1.1",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "^14.2.18",
    "next-auth": "^5.0.0-beta.25",
    "otplib": "^12.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.17.9",
    "@types/react": "^18.3.14",
    "@types/react-dom": "^18.3.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.18",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
