// Woodbridge Nutrition Platform — full schema for ALL entities (phase 1).
// Later phases must never migrate destructively, so every entity exists now.
//
// Domain rules enforced structurally here (CLAUDE.md):
//   1. Money is integer cents. Every money column ends in `Cents`.
//   2. The ledger is append-only (no updatedAt on LedgerEntry). Corrections are
//      NEW offsetting entries linked via `correctsEntryId`.
//   3. Transfers share one `transferRef`.
//   4. `idempotencyKey` is unique (nullable — Postgres allows multiple NULLs).
//   6. Meal uniqueness: one live normal event per student/date/meal type.
//   9. Student holds ONLY minimal fields — no race/ethnicity/gender/birthdate.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  GUARDIAN
  CASHIER
  SCHOOL_STAFF
  DISTRICT_ADMIN
  SUPER_ADMIN
}

enum EnrollmentStatus {
  ACTIVE
  INACTIVE
}

enum MealType {
  BREAKFAST
  LUNCH
}

enum LedgerEntryType {
  DEPOSIT
  MEAL_CHARGE
  ALACARTE_CHARGE
  TRANSFER_DEBIT
  TRANSFER_CREDIT
  ADJUSTMENT
  REFUND
  CORRECTION
}

enum ActorType {
  GUARDIAN
  USER
  SYSTEM
}

// Derived pricing INPUT — never an eligibility record (open-decisions.md #2).
// Read only inside server/meals pricing logic; never exposed to POS/guardians.
enum PriceTier {
  FREE
  REDUCED
  PAID
}

// Where a student's price tier came from (production may derive from FRAM).
enum PricingSource {
  DISTRICT_EXPORT
  MANUAL
  DEFAULT
}

enum CorrectionSituation {
  CHARGED_TWICE
  WRONG_STUDENT
  SNACK_RETURNED
  SOMETHING_ELSE
  DISTRICT_DECISION
}

enum CorrectionCaseStatus {
  PENDING
  FOLLOW_UP_REQUIRED
  COMPLETED
}

enum NotificationType {
  LOW_BALANCE
  DEPOSIT_COMPLETED
  TRANSFER_COMPLETED
  AUTO_TOP_UP_COMPLETED
  AUTO_TOP_UP_SKIPPED
}

enum NotificationChannel {
  IN_APP
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
}

enum PaymentIntentStatus {
  PENDING
  COMPLETED
  FAILED
}

enum AutomaticTopUpRunStatus {
  PENDING
  COMPLETED
  SKIPPED_CEILING
  FAILED
}

enum AttendanceFactorProvenance {
  FNS_FEDERAL_DEFAULT
  APPROVED_LOCAL
}

// ---------------------------------------------------------------------------
// Directory: district / school / student
// ---------------------------------------------------------------------------

model District {
  id                              String                     @id @default(cuid())
  name                            String
  identifiedStudentPercentageBps  Int?
  // External compliance input. Woodbridge's seed uses the 93.8% FNS federal
  // default because no Delaware-specific published percentage was found (D-14).
  stateAttendanceFactorBps        Int?
  stateAttendanceFactorProvenance AttendanceFactorProvenance @default(FNS_FEDERAL_DEFAULT)
  // District-authored plain-text unpaid meal charge policy. Seed stays unset
  // until Woodbridge supplies its own wording (D-19/D-20).
  unpaidMealChargePolicyText      String?
  timeZone                        String                     @default("America/New_York")
  createdAt                       DateTime                   @default(now())
  updatedAt                       DateTime                   @updatedAt

  schools        School[]
  students       Student[]
  users          User[]
  items          Item[]
  pricingConfigs PricingConfig[]
  importRuns     ImportRun[]
  notifications  Notification[]
}

model School {
  id                         String   @id @default(cuid())
  districtId                 String
  name                       String
  code                       String
  breakfastServiceEndMinutes Int?
  lunchServiceEndMinutes     Int?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  district       District        @relation(fields: [districtId], references: [id])
  students       Student[]
  userSchools    UserSchool[]
  items          Item[]
  pricingConfigs PricingConfig[]
  notifications  Notification[]
  mealEvents     MealEvent[]
  classrooms     Classroom[]

  @@unique([districtId, code])
}

// Teacher-named operational group for roster-mode meal recording (D-13).
// Classroom membership is maintained separately from the student-list upload.
model Classroom {
  id          String  @id @default(cuid())
  teacherName String
  schoolId    String
  grade       String?
  active      Boolean @default(true)

  school   School    @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  students Student[] @relation("StudentClassroom")

  // Supports Student's composite FK, which makes a cross-school classroom
  // assignment impossible even if a future caller skips the domain guard.
  @@unique([id, schoolId])
  @@index([schoolId, active])
}

// Data minimization (rule 9): minimal identity/enrollment fields plus D-13's
// operational classroom FK. Race, ethnicity, gender, and birthdate must never exist.
model Student {
  id               String           @id @default(cuid())
  districtId       String
  schoolId         String
  classroomId      String?
  studentNumber    String
  firstName        String
  lastName         String
  middleName       String? // never displayed by default
  grade            String
  enrollmentStatus EnrollmentStatus @default(ACTIVE)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  district                District             @relation(fields: [districtId], references: [id])
  school                  School               @relation(fields: [schoolId], references: [id])
  classroom               Classroom?           @relation("StudentClassroom", fields: [classroomId, schoolId], references: [id, schoolId], onDelete: Restrict, onUpdate: Cascade)
  account                 Account?
  pricing                 StudentPricing? // pricing INPUT only — not part of the rule-9 field list
  guardianLinks           GuardianStudent[]
  mealEvents              MealEvent[]
  itemSales               ItemSale[]
  paymentAllocations      PaymentAllocation[]
  correctionCases         CorrectionCase[]     @relation("CorrectionCaseStudent")
  targetedCorrectionCases CorrectionCase[]     @relation("CorrectionCaseTargetStudent")
  autoTopUpRules          AutomaticTopUpRule[]

  @@unique([districtId, studentNumber])
  @@index([schoolId])
  @@index([classroomId])
}

// Pricing INPUT for a student, kept OFF the Student record so rule 9's field
// list stands unamended. Read only by server/meals pricing logic and by the
// guardian household query for a verified linked child — never in POS, exports,
// reports, page source, client state, logs, or general admin views.
model StudentPricing {
  id            String        @id @default(cuid())
  studentId     String        @unique
  tier          PriceTier     @default(FREE)
  effectiveFrom DateTime      @default(now())
  source        PricingSource @default(DEFAULT)
  createdAt     DateTime      @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Household: guardian (auth principal) + verified guardian-student link
// ---------------------------------------------------------------------------

model Guardian {
  id               String    @id @default(cuid())
  email            String    @unique
  passwordHash     String
  firstName        String
  lastName         String
  phone            String?
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  studentLinks   GuardianStudent[]
  notifications  Notification[]
  paymentIntents PaymentIntent[]
  autoTopUpRules AutomaticTopUpRule[]
}

model GuardianStudent {
  id           String   @id @default(cuid())
  guardianId   String
  studentId    String
  relationship String?
  createdAt    DateTime @default(now())

  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([guardianId, studentId])
  @@index([studentId])
}

// ---------------------------------------------------------------------------
// Staff auth principal + school scope
// ---------------------------------------------------------------------------

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  passwordHash     String
  firstName        String
  lastName         String
  role             Role
  districtId       String
  totpSecret       String? // pre-enrolled for staff so the demo shows MFA
  totpEnrolledAt   DateTime?
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  disabledAt       DateTime? // staff are deactivated, never deleted (audit refs actorId)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  district                 District         @relation(fields: [districtId], references: [id])
  schools                  UserSchool[]
  recordedMealEvents       MealEvent[]      @relation("MealRecordedBy")
  reversedMealEvents       MealEvent[]      @relation("MealReversedBy")
  correctionCases          CorrectionCase[] @relation("CorrectionCaseActor")
  completedCorrectionCases CorrectionCase[] @relation("CorrectionCaseCompletedBy")
  createdPricingConfigs    PricingConfig[]  @relation("PricingConfigCreatedBy")
  cancelledPricingConfigs  PricingConfig[]  @relation("PricingConfigCancelledBy")
}

model UserSchool {
  id       String @id @default(cuid())
  userId   String
  schoolId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([userId, schoolId])
}

// ---------------------------------------------------------------------------
// Money: account + append-only ledger
// ---------------------------------------------------------------------------

model Account {
  id           String   @id @default(cuid())
  studentId    String   @unique
  balanceCents Int      @default(0) // cached optimization; ledger is source of truth
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  student       Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  ledgerEntries LedgerEntry[]
}

// Append-only: NO updatedAt, never UPDATE/DELETE. Corrections are new rows.
model LedgerEntry {
  id              String          @id @default(cuid())
  accountId       String
  type            LedgerEntryType
  amountCents     Int // signed: positive credit, negative debit
  description     String
  idempotencyKey  String?         @unique
  transferRef     String? // links a debit+credit transfer pair
  correctsEntryId String?
  actorType       ActorType
  actorId         String?
  createdAt       DateTime        @default(now())

  account                  Account             @relation(fields: [accountId], references: [id])
  correctsEntry            LedgerEntry?        @relation("Corrections", fields: [correctsEntryId], references: [id])
  correctedBy              LedgerEntry[]       @relation("Corrections")
  mealEvent                MealEvent?
  itemSale                 ItemSale?
  autoTopUpTriggers        AutomaticTopUpRun[] @relation("AutomaticTopUpTrigger")
  autoTopUpDeposits        AutomaticTopUpRun[] @relation("AutomaticTopUpDeposit")
  correctionCaseOriginal   CorrectionCase?     @relation("CorrectionCaseOriginal")
  correctionCaseRefund     CorrectionCase?     @relation("CorrectionCaseRefund")
  correctionCaseCharge     CorrectionCase?     @relation("CorrectionCaseCharge")
  correctionCaseAdjustment CorrectionCase?     @relation("CorrectionCaseAdjustment")

  @@index([accountId])
  @@index([transferRef])
}

model CorrectionCase {
  id                  String               @id @default(cuid())
  situation           CorrectionSituation
  status              CorrectionCaseStatus @default(PENDING)
  studentId           String
  originalEntryId     String?              @unique
  targetStudentId     String?
  reason              String
  actorId             String?
  refundEntryId       String?              @unique
  chargeEntryId       String?              @unique
  adjustmentEntryId   String?              @unique
  expectedAmountCents Int?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  completedAt         DateTime?
  completedByUserId   String?

  student         Student      @relation("CorrectionCaseStudent", fields: [studentId], references: [id], onDelete: Restrict)
  targetStudent   Student?     @relation("CorrectionCaseTargetStudent", fields: [targetStudentId], references: [id], onDelete: Restrict)
  actor           User?        @relation("CorrectionCaseActor", fields: [actorId], references: [id], onDelete: SetNull)
  completedBy     User?        @relation("CorrectionCaseCompletedBy", fields: [completedByUserId], references: [id], onDelete: SetNull)
  originalEntry   LedgerEntry? @relation("CorrectionCaseOriginal", fields: [originalEntryId], references: [id], onDelete: Restrict)
  refundEntry     LedgerEntry? @relation("CorrectionCaseRefund", fields: [refundEntryId], references: [id], onDelete: SetNull)
  chargeEntry     LedgerEntry? @relation("CorrectionCaseCharge", fields: [chargeEntryId], references: [id], onDelete: SetNull)
  adjustmentEntry LedgerEntry? @relation("CorrectionCaseAdjustment", fields: [adjustmentEntryId], references: [id], onDelete: SetNull)

  @@index([studentId])
  @@index([targetStudentId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Meals + a-la-carte
// ---------------------------------------------------------------------------

model MealEvent {
  id               String    @id @default(cuid())
  studentId        String
  schoolId         String
  serviceDate      DateTime  @db.Date
  mealType         MealType
  priceCents       Int
  // 0 = the normal POS serving (one live row per student/date/mealType — the duplicate
  // guard). Only an admin duplicate-meal override creates seq > 0, and only with
  // an overrideReason + AuditLog. The POS can NEVER produce seq > 0 (rule 6).
  overrideSeq      Int       @default(0)
  recordedByUserId String?
  recordingBatchId String?
  ledgerEntryId    String?   @unique
  overrideReason   String?
  reversedAt       DateTime?
  reversedByUserId String?
  createdAt        DateTime  @default(now())

  student        Student      @relation(fields: [studentId], references: [id])
  school         School       @relation(fields: [schoolId], references: [id])
  recordedByUser User?        @relation("MealRecordedBy", fields: [recordedByUserId], references: [id], onDelete: Restrict)
  reversedByUser User?        @relation("MealReversedBy", fields: [reversedByUserId], references: [id], onDelete: Restrict)
  ledgerEntry    LedgerEntry? @relation(fields: [ledgerEntryId], references: [id])

  // Live-event uniqueness is enforced by a partial PostgreSQL index because a
  // retained, reversed row must not block an ordinary re-entry. Prisma cannot
  // express the WHERE clause, so the migration owns that index.
  @@index([studentId, serviceDate, mealType, overrideSeq])
  @@index([schoolId, serviceDate, mealType])
  @@index([recordedByUserId, schoolId, createdAt])
  @@index([recordingBatchId])
  @@index([serviceDate])
}

model Item {
  id         String   @id @default(cuid())
  districtId String
  schoolId   String? // null = district-wide item
  name       String
  priceCents Int
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  district District   @relation(fields: [districtId], references: [id])
  school   School?    @relation(fields: [schoolId], references: [id])
  sales    ItemSale[]
}

model ItemSale {
  id               String   @id @default(cuid())
  itemId           String
  studentId        String
  priceCentsAtSale Int // price captured at time of purchase
  ledgerEntryId    String?  @unique
  createdAt        DateTime @default(now())

  item        Item         @relation(fields: [itemId], references: [id])
  student     Student      @relation(fields: [studentId], references: [id])
  ledgerEntry LedgerEntry? @relation(fields: [ledgerEntryId], references: [id])

  @@index([studentId])
}

// ---------------------------------------------------------------------------
// Audit + import + pricing config
// ---------------------------------------------------------------------------

model AuditLog {
  id          String    @id @default(cuid())
  actorType   ActorType
  actorId     String?
  action      String
  subjectType String?
  subjectId   String?
  districtId  String?
  schoolId    String?
  reason      String?
  beforeJson  Json?
  afterJson   Json?
  ip          String?
  createdAt   DateTime  @default(now())

  @@index([subjectType, subjectId])
  @@index([action])
  @@index([createdAt])
}

model ImportRun {
  id               String   @id @default(cuid())
  districtId       String
  source           String
  operator         String
  checksum         String?
  status           String
  createdCount     Int      @default(0)
  updatedCount     Int      @default(0)
  inactiveCount    Int      @default(0)
  skippedCount     Int      @default(0)
  failedCount      Int      @default(0)
  errorsJson       Json?
  // Records a mass-deactivation confirmation when the safety threshold tripped:
  // { deactivateCount, activeBefore, sharePct, confirmedBy, confirmedAt }.
  confirmationJson Json?
  createdAt        DateTime @default(now())

  district District @relation(fields: [districtId], references: [id])
}

// Three configurable pricing paths per meal (PRD business rules; phase 5 §17).
// Free tier is a configurable field too (normally 0). Versions are immutable
// and resolved by meal service date (D-22). Future versions may be cancelled
// before they take effect; effective versions are superseded, never edited.
model PricingConfig {
  id                       String    @id @default(cuid())
  districtId               String
  schoolId                 String? // null = district-wide default
  createdByUserId          String?
  cancelledAt              DateTime?
  cancelledByUserId        String?
  breakfastFreeCents       Int       @default(0)
  breakfastReducedCents    Int       @default(0)
  breakfastPaidCents       Int       @default(0)
  lunchFreeCents           Int       @default(0)
  lunchReducedCents        Int       @default(0)
  lunchPaidCents           Int       @default(0)
  lowBalanceThresholdCents Int       @default(1000)
  lowBalanceMealsThreshold Int       @default(5)
  cepEnabled               Boolean   @default(true) // Woodbridge demo default: CEP $0
  effectiveFrom            DateTime  @default(now()) @db.Date
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  district    District @relation(fields: [districtId], references: [id])
  school      School?  @relation(fields: [schoolId], references: [id])
  createdBy   User?    @relation("PricingConfigCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  cancelledBy User?    @relation("PricingConfigCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: SetNull)

  @@index([districtId, schoolId, effectiveFrom, createdAt])
  @@index([districtId, schoolId, cancelledAt, effectiveFrom])
}

// ---------------------------------------------------------------------------
// Notifications (phase 5 builds generation + the NotificationPort; schema now)
// In-app only for the pilot. Guardians see them in a portal inbox; admins view
// the delivery log — the evidence trail for "did the parent get told?".
// ---------------------------------------------------------------------------

model Notification {
  id         String           @id @default(cuid())
  districtId String
  schoolId   String?
  guardianId String
  type       NotificationType
  title      String
  body       String
  readAt     DateTime?
  createdAt  DateTime         @default(now())

  district   District               @relation(fields: [districtId], references: [id])
  school     School?                @relation(fields: [schoolId], references: [id])
  guardian   Guardian               @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@index([guardianId])
  @@index([districtId])
}

model NotificationDelivery {
  id             String                     @id @default(cuid())
  notificationId String
  channel        NotificationChannel        @default(IN_APP)
  status         NotificationDeliveryStatus @default(PENDING)
  detail         String?
  createdAt      DateTime                   @default(now())

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([notificationId])
}

// ---------------------------------------------------------------------------
// Automatic top-up rules. A guardian-owned rule has its own lifecycle, so it is
// separate from Student. Credits still pass through PaymentIntent settlement.
// ---------------------------------------------------------------------------

model AutomaticTopUpRule {
  id                  String    @id @default(cuid())
  guardianId          String
  studentId           String
  triggerBalanceCents Int
  topUpAmountCents    Int
  monthlyCeilingCents Int
  active              Boolean   @default(true)
  cancelledAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  guardian Guardian            @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  student  Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  runs     AutomaticTopUpRun[]

  @@index([guardianId])
  @@index([studentId])
  @@index([guardianId, studentId, active])
}

model AutomaticTopUpRun {
  id                      String                  @id @default(cuid())
  ruleId                  String
  triggeringLedgerEntryId String?
  depositLedgerEntryId    String?
  idempotencyKey          String                  @unique
  status                  AutomaticTopUpRunStatus @default(PENDING)
  balanceAfterCents       Int
  amountCents             Int
  ceilingCents            Int
  skippedReason           String?
  createdAt               DateTime                @default(now())
  completedAt             DateTime?

  rule                  AutomaticTopUpRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  triggeringLedgerEntry LedgerEntry?       @relation("AutomaticTopUpTrigger", fields: [triggeringLedgerEntryId], references: [id], onDelete: SetNull)
  depositLedgerEntry    LedgerEntry?       @relation("AutomaticTopUpDeposit", fields: [depositLedgerEntryId], references: [id], onDelete: SetNull)
  paymentIntent         PaymentIntent?

  @@index([ruleId])
  @@index([triggeringLedgerEntryId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Payments (phase 2 — simulated hosted checkout)
// PaymentIntent is the server-side source of truth for a deposit's amount. The
// ledger credit is applied ONLY when the signed provider event settles the
// intent (server/ports/payment.ts) — never from a client redirect. `eventId`
// (the provider event id) is unique so a replayed event settles at most once.
// ---------------------------------------------------------------------------

model PaymentIntent {
  id                  String              @id @default(cuid()) // also the opaque checkoutId
  guardianId          String
  status              PaymentIntentStatus @default(PENDING)
  totalCents          Int
  eventId             String?             @unique // provider event id, set on settle
  automaticTopUpRunId String?             @unique
  createdAt           DateTime            @default(now())
  completedAt         DateTime?

  guardian          Guardian            @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  automaticTopUpRun AutomaticTopUpRun?  @relation(fields: [automaticTopUpRunId], references: [id], onDelete: SetNull)
  allocations       PaymentAllocation[]

  @@index([guardianId])
}

model PaymentAllocation {
  id          String @id @default(cuid())
  intentId    String
  studentId   String
  amountCents Int

  intent  PaymentIntent @relation(fields: [intentId], references: [id], onDelete: Cascade)
  student Student       @relation(fields: [studentId], references: [id])

  @@index([intentId])
}
